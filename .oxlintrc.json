{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [],
  "categories": {
    "correctness": "off"
  },
  "env": {
    "builtin": true,
    "browser": true,
    "node": true
  },
  "ignorePatterns": ["dist/**"],
  "rules": {
    "curly": ["error", "multi-line"],
    "no-use-before-define": ["error", { "functions": false }]
  }
}
